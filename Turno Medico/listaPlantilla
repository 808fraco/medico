#ifndef DDD_H_INCLUDED
#define DDD_H_INCLUDED
#define MAX 30
#include <stdio.h>
#include <stdlib.h>
typedef struct{
    int vipd[MAX];
    int cursor;
    int ultimo;
}Entero;

void inic(Entero *e){
    e->cursor = -1;
    e->ultimo = -1;
}

int isEmpty(Entero e){
    return(e.ultimo == -1);
}

int isFull(Entero e){
    return(e.ultimo == MAX-1);
}

int isOos(Entero e){
    return(e.cursor == -1);
}
void reset(Entero *e){
    if(isEmpty(*e)){
        e->cursor = -1;
    }else{
        e->cursor = 0;
    }
}

void forwards(Entero *e){
    if(!isOos(*e)){
        if(e->cursor < e->ultimo){
            e->cursor++;
        }else{
            e->cursor = -1;
        }
    }
}

int copy(Entero e){
    if(isOos(e)){
        printf("Error: Intento de copia con cursor fuera de estructura.\n");
        return -1;
    }
    return e.vipd[e.cursor];
}

void insert(Entero *e, int elem){
    int i;
    if(isFull(*e)){
        printf("Error de Desborde: La lista está llena.\n");
        return;
    }
    if(isEmpty(*e) || isOos(*e)){
        e->ultimo++;
        e->vipd[e->ultimo] = elem;
        e->cursor = e->ultimo;
    }else{
        for(i=e->ultimo; i>=e->cursor; i--){
            e->vipd[i+1] = e->vipd[i];
        }
        e->vipd[e->cursor] = elem;
        e->ultimo++;
    }
}
void supress(Entero *e){
    if(isOos(*e) || isEmpty(*e)){
        printf("Error de Desfonde/OOS: No hay elemento corriente para suprimir.\n");
        return;
    }
    int i;
    for(i=e->cursor;i<e->ultimo;i++){
        e->vipd[i] = e->vipd[i+1];
    }
    e->ultimo--;
    if(e->ultimo == -1){
        e->cursor = -1;
    }else if(e->cursor > e->ultimo){
        e->cursor = e->ultimo;
    }
}
#endif // DDD_H_INCLUDED
