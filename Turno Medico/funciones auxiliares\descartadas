// mostrar fecha en formato: dia,mes,año,hora,minuto y el estado del turno
void mostrarFecha(Fecha f){
    printf("%02d/%02d/%d %02d:%02d hs [%s]\n",
       f.dia, f.mes, f.anio, f.hora, f.minuto,
       (f.disponible == LIBRE) ? "Libre" : "Ocupado");
}
//! k)
void mostrarTodosTurnos(Lista v){
    int cuentaPag = 0, pagActual = 0, i; // cuenta las paginas q imprime la lista de turnos
    resetL(&v);
    Turno t;
    initTurno(&t);
    while(!isOol(v)){
        t = copyL(v);
        int o;
        printf("\n");
        mostrarUnTurno(t);
        forwardL(&v);
        if(pagActual == 0){
            if(cuentaPag == TAM_PAG){
            printf("\n-----[1: Siguiente p%cgina | 0: Salir]-----\n");
            o = limite(0,1);
        }
        }
        if(cuentaPag == TAM_PAG){
            printf("\n-----[1: Siguiente p%cgina | 2: P%cgina anterior | 0: Salir]-----\n");
            o = limite(0,2);
        }
        if(o == 1 && cuentaPag == 0){
            pagActual++;
        }else if(o == 1){
            pagActual++;
        }else if(o == 2){
            for(i=0;i<((pagActual-1)*TAM_PAG);i++){
                resetL(&v);
                printf("\n");
                mostrarUnTurno(t);
                forwardL(&v);
            }
            pagActual--;
        }else if(o == 0){
            break;
        }
        cuentaPag++;
    }
    return;
}
